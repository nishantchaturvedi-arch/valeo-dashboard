# Configure in the backend hosting environment. Never put secrets in browser files.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Separate locked database; the service refuses the existing default database.
FIRESTORE_DATABASE_ID=uae-leads
# Firebase Authentication UID of the one account mapped to valeo_admin.
VALEO_ADMIN_UID=
# Optional separate account with viewer access to the exact source spreadsheet.
SHEETS_SERVICE_ACCOUNT_JSON=
# Generate at least 32 random bytes. Store the same value in n8n Header Auth.
LEAD_SYNC_SECRET=
# Use a bot with chat:write. Invite it to the chosen channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Private source ID, configured only on the backend.
LEAD_SOURCE_SPREADSHEET_ID=
